<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <script src="js/main.js" defer></script>
        <link rel="stylesheet" href="css/main.css">
    </head>
    <body id="body">
        <h1>Welcome! if you expected this to look good think again!</h1>
        <h2>model containerization</h2>
        <label for="sepalLength">Sepal Length</label>
        <input type="number" id="sepalLength"/>
        <label for="sepalWidth">Sepal Width</label>
        <input type="number" id="sepalWidth"/>
        <label for="petalLength">Petal Length</label>
        <input type="number" id="petalLength"/>
        <label for="petalWidth">Petal Width</label>
        <input type="number" id="petalWidth"/>
        <button id="submit">Submit</button>
        <p id="modelOutput"></p>
        <h2>LLM stuff</h2>
        <h3>chat</h3>
        <div id="chatOutput">

        </div>
        <input type="text" id="chatInput" placeholder="Type your message here..."/>
        <button id="chatButton">Send</button>
        <h3>bestimate, it is a pun, you see, it is like zestimate, but with best instead of zest, like best-estimate, ahh yes, I am so funny</h3>
        <input type="text" id="bestimateLocation" placeholder="Enter a location"/>
        <input type="number" id="bestimateFootage" placeholder="Enter a square footage"/>
        <input type="text" id="bestimateDescription" placeholder="Enter a description"/>
        <button id="bestimateButton">Submit</button>
        <div id="bestimateEstimate"></div>
        <div id="bestimateConfidence"></div>
        <h2>basic docker demo</h2>
        <ul id="items"></ul>
        <button id="newRecordPush">Push New Record</button>
        <p contenteditable="true" id="newRecord">{}</p>
    </body>
</html>